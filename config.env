# Configuration du setup — sourcé par setup.sh et chaque étape.
# Les valeurs peuvent être surchargées par l'environnement : LLAMA_CPP_REF=b6500 ./setup.sh

# Révision de llama.cpp à compiler (branche, tag bXXXX ou commit).
# Épingler un tag connu comme bon pour un setup reproductible.
LLAMA_CPP_REF="${LLAMA_CPP_REF:-master}"
LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"

# Emplacements
SRC_DIR="${SRC_DIR:-$HOME/.local/src}"
OPT_DIR="${OPT_DIR:-$HOME/.local/opt}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
MODELS_DIR="${MODELS_DIR:-$HOME/models}"

# Backend dont les binaires sont exposés dans $BIN_DIR (vulkan | rocm)
DEFAULT_BACKEND="${DEFAULT_BACKEND:-vulkan}"

# llama-swap (étape 40) — config des modèles : config/llama-swap.yaml
LLAMA_SWAP_VERSION="${LLAMA_SWAP_VERSION:-258}"
# 127.0.0.1 = accessible uniquement depuis cette machine ; 0.0.0.0 = depuis le réseau (pas d'auth par défaut !)
LLAMA_SWAP_LISTEN="${LLAMA_SWAP_LISTEN:-127.0.0.1:8080}"
# 1 = le service démarre au boot même sans session ouverte (loginctl enable-linger)
LLAMA_SWAP_LINGER="${LLAMA_SWAP_LINGER:-0}"

# Open WebUI + SearXNG (étape 50), conteneurs podman gérés par systemd (Quadlet)
OPEN_WEBUI_IMAGE="${OPEN_WEBUI_IMAGE:-ghcr.io/open-webui/open-webui:v0.11.4}"
OPEN_WEBUI_PORT="${OPEN_WEBUI_PORT:-3000}"
SEARXNG_IMAGE="${SEARXNG_IMAGE:-docker.io/searxng/searxng:2026.9.25-487f51922}"
SEARXNG_PORT="${SEARXNG_PORT:-8888}"
# Secrets et état générés localement (jamais dans le repo)
STATE_DIR="${STATE_DIR:-$HOME/.config/strix-halo-inference}"
